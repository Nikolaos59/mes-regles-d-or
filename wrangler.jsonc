{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mes-regles-d-or",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "vars": {
    "SITE_NOINDEX": "true"
  }
}
